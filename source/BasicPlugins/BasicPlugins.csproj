<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <OutputPath>$(OpenIrisPluginsDir)</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Emgu.CV" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Calibration\EyeCalibrationNPointUI.cs" SubType="UserControl" />
    <Compile Update="EyeTrackingSystems\FakeEyeControlUI.cs" SubType="Form" />
    <Compile Update="Properties\Resources.Designer.cs" AutoGen="True" DesignTime="True" DependentUpon="Resources.resx" />
    <!-- Explicit DependentUpon keeps the form resources named after the form class (OpenIris.*), not the folder path. -->
    <EmbeddedResource Update="Calibration\EyeCalibrationNPointUI.resx" DependentUpon="EyeCalibrationNPointUI.cs" />
    <EmbeddedResource Update="EyeTrackingSystems\FakeEyeControlUI.resx" DependentUpon="FakeEyeControlUI.cs" />
    <EmbeddedResource Update="Properties\Resources.resx" Generator="ResXFileCodeGenerator" LastGenOutput="Resources.Designer.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenIrisLib\OpenIrisLib.csproj">
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>
</Project>
