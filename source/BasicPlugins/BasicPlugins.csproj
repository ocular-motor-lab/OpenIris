<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <OutputPath>$(OpenIrisPluginsDir)</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Emgu.CV" />
    <PackageReference Include="Emgu.CV.Bitmap" />
    <!-- ONNX Runtime, for the appearance gaze. OpenIris has it in lib\. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="SyntheticEyes\SyntheticEyesUI.cs" SubType="Form" />
    <Compile Update="Properties\Resources.Designer.cs" AutoGen="True" DesignTime="True" DependentUpon="Resources.resx" />
    <!-- Explicit DependentUpon keeps the form resources named after the form class (OpenIris.*), not the folder path. -->
    <EmbeddedResource Update="SyntheticEyes\SyntheticEyesUI.resx" DependentUpon="SyntheticEyesUI.cs" />
    <EmbeddedResource Update="Properties\Resources.resx" Generator="ResXFileCodeGenerator" LastGenOutput="Resources.Designer.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Neural networks of the webcam system and pipeline, in Plugins\WebcamModels\, and the licenses of the
         networks and of ONNX Runtime (which runs saccade.js's). See its README.md. -->
    <None Include="Webcam\Models\*.onnx;Webcam\Models\*.txt;Webcam\Models\README.md" Link="WebcamModels\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenIrisLib\OpenIrisLib.csproj">
      <Private>False</Private>
    </ProjectReference>
    <ProjectReference Include="..\OpenIrisWinForms\OpenIrisWinForms.csproj">
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>
</Project>
