<Project>
  <!-- Settings shared by every SDK-style project under source\. MSBuild imports this file automatically,
       before the project file itself, so a project can still override anything set here.
       Legacy (non-SDK) projects, if one is ever added, are left alone. -->
  <PropertyGroup Condition="'$(UsingMicrosoftNETSdk)' == 'true'">
    <!-- This file is imported before the SDK defaults Configuration, so default it here for OutputPath. -->
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <TargetFramework>net48</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>8.0</LangVersion>
    <!-- AssemblyInfo.cs files are kept in each project. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- OpenIris.exe builds into OpenIrisBinDir, the libraries into lib\ (OpenIrisLibDir) and the plugins
         into Plugins\ (OpenIrisPluginsDir), so the folder of OpenIris.exe stays tidy. -->
    <OpenIrisBinDir>$(MSBuildThisFileDirectory)..\bin\x64\$(Configuration)\</OpenIrisBinDir>
    <OpenIrisLibDir>$(OpenIrisBinDir)lib\</OpenIrisLibDir>
    <OpenIrisPluginsDir>$(OpenIrisBinDir)Plugins\</OpenIrisPluginsDir>
    <OutputPath>$(OpenIrisBinDir)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Intermediate files (obj) in the solution's bin folder too, one folder per project, not next to the
         sources. Has to be set here: the SDK uses it before it reads the project file. -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\bin\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <!-- GitVersion 5 passes this path to gitversion.exe without quotes, so it can't have spaces (the full path
         has them): relative to the project folder, where MSBuild runs. -->
    <!-- Old obj and bin folders next to the sources aren't sources. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
    <GitVersionOutputFile>$([MSBuild]::MakeRelative($([MSBuild]::EnsureTrailingSlash($(MSBuildProjectDirectory))), $(BaseIntermediateOutputPath)))gitversion.json</GitVersionOutputFile>
    <!-- Don't copy ZedGraph's (an Emgu.CV.UI dependency) translated resources. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UsingMicrosoftNETSdk)' == 'true' and '$(Configuration)' == 'Debug'">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UsingMicrosoftNETSdk)' == 'true' and '$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
</Project>
