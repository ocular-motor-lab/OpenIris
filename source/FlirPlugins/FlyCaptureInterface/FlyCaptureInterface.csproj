<Project>
  <!-- The SDK is imported explicitly (not <Project Sdk=...>) so that SkipWithoutFlyCaptureSdk.targets,
       imported after it, can replace the build targets when the FlyCapture SDK isn't installed. -->
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <Import Project="FlyCaptureSdk.props" />
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>PointGreyInterface</RootNamespace>
    <AssemblyName>PointGreyInterface</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>$(OpenIrisPluginsDir)</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\OpenIrisLib\OpenIrisLib.csproj">
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="SkipWithoutFlyCaptureSdk.targets" Condition="!Exists('$(FlyCaptureSdkDir)FlyCapture2Managed_v140.dll')" />
</Project>
