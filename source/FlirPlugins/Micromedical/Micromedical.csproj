<Project>
  <!-- The SDK is imported explicitly, as in FlyCaptureInterface, so the plugin is skipped when the
       FlyCapture SDK isn't installed. -->
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <Import Project="..\FlyCaptureInterface\FlyCaptureSdk.props" />
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <OutputPath>$(OpenIrisPluginsDir)</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="FTD2XX_NET">
      <HintPath>FTD2XX_NET.dll</HintPath>
    </Reference>
    <Reference Include="MccDaq">
      <HintPath>MccDaq.dll</HintPath>
    </Reference>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Emgu.CV" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FlyCaptureInterface\FlyCaptureInterface.csproj" />
    <ProjectReference Include="..\..\OpenIrisLib\OpenIrisLib.csproj">
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="..\FlyCaptureInterface\SkipWithoutFlyCaptureSdk.targets" Condition="!Exists('$(FlyCaptureSdkDir)FlyCapture2Managed_v140.dll')" />
</Project>
