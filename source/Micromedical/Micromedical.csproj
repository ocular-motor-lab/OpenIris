<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <OutputPath>$(OpenIrisPluginsDir)</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="FTD2XX_NET">
      <HintPath>FTD2XX_NET.dll</HintPath>
    </Reference>
    <Reference Include="MccDaq">
      <HintPath>MccDaq.dll</HintPath>
    </Reference>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Emgu.CV" />
  </ItemGroup>
  <!-- Copy-to-output items (not just copy-local references) also flow through OpenIris' solution build
       dependency on this project, which puts these DLLs next to OpenIris.exe as the legacy project did. -->
  <ItemGroup>
    <None Update="MccDaq.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Update="FTD2XX_NET.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FlyCaptureInterface\FlyCaptureInterface.csproj" />
    <ProjectReference Include="..\OpenIrisLib\OpenIrisLib.csproj">
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>
</Project>
