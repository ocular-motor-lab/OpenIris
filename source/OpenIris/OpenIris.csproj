<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>OpenIris.UI</RootNamespace>
    <AssemblyName>OpenIris</AssemblyName>
    <ApplicationIcon>OpenIris.ico</ApplicationIcon>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Windows.Forms.DataVisualization" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Emgu.CV" />
    <!-- OpenIrisLib's web server. Referenced here too so the binding redirects it needs
         (System.ValueTuple, for Swan.Lite) go into OpenIris.exe.config. -->
    <PackageReference Include="EmbedIO" />
    <PackageReference Include="GitVersion.MsBuild" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Small sample videos played by the Simulation eye tracking system. -->
    <None Include="..\..\sample-videos\*.mp4" Link="SampleVideos\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="EyeTrackerAboutBox.cs" SubType="Form" />
    <Compile Update="EyeTrackerGui.cs" SubType="Form" />
    <Compile Update="Properties\Resources.Designer.cs" AutoGen="True" DesignTime="True" DependentUpon="Resources.resx" />
    <EmbeddedResource Update="Properties\Resources.resx" Generator="ResXFileCodeGenerator" LastGenOutput="Resources.Designer.cs" />
  </ItemGroup>
  <!-- The full quality sample videos, if both are in sample-videos (gitignored). Simulation plays them instead of the MP4s. -->
  <ItemGroup Condition="Exists('..\..\sample-videos\JorgeLeft.avi') And Exists('..\..\sample-videos\JorgeRight.avi')">
    <Content Include="..\..\sample-videos\JorgeLeft.avi" Link="SampleVideos\JorgeLeft.avi" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\sample-videos\JorgeRight.avi" Link="SampleVideos\JorgeRight.avi" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Everything OpenIris.exe uses goes in lib\ (App.config tells .NET to look there), so its folder only
       has the program, its configuration and settings files, and folders (and the sample videos). -->
  <Target Name="PutLibrariesInLib" BeforeTargets="_CopyFilesMarkedCopyLocal">
    <ItemGroup>
      <ReferenceCopyLocalPaths Update="@(ReferenceCopyLocalPaths)" DestinationSubDirectory="lib\%(ReferenceCopyLocalPaths.DestinationSubDirectory)" />
    </ItemGroup>
  </Target>
  <PropertyGroup>
    <SampleVideosDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\sample-videos\'))</SampleVideosDir>
  </PropertyGroup>
  <Target Name="PutFilesToCopyInLib" AfterTargets="GetCopyToOutputDirectoryItems">
    <ItemGroup>
      <_OpenIrisToLib Include="@(_SourceItemsToCopyToOutputDirectory)" Condition="'%(_SourceItemsToCopyToOutputDirectory.RootDir)%(_SourceItemsToCopyToOutputDirectory.Directory)' != '$(SampleVideosDir)'" />
      <_SourceItemsToCopyToOutputDirectory Remove="@(_OpenIrisToLib)" />
      <_SourceItemsToCopyToOutputDirectory Include="@(_OpenIrisToLib)" TargetPath="lib\%(_OpenIrisToLib.TargetPath)" />
      <_OpenIrisToLibAlways Include="@(_SourceItemsToCopyToOutputDirectoryAlways)" Condition="'%(_SourceItemsToCopyToOutputDirectoryAlways.RootDir)%(_SourceItemsToCopyToOutputDirectoryAlways.Directory)' != '$(SampleVideosDir)'" />
      <_SourceItemsToCopyToOutputDirectoryAlways Remove="@(_OpenIrisToLibAlways)" />
      <_SourceItemsToCopyToOutputDirectoryAlways Include="@(_OpenIrisToLibAlways)" TargetPath="lib\%(_OpenIrisToLibAlways.TargetPath)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\OpenIrisLib\OpenIrisLib.csproj" />
    <ProjectReference Include="..\OpenIrisWinForms\OpenIrisWinForms.csproj" />
  </ItemGroup>
</Project>
