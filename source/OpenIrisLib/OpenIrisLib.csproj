<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>OpenIris</RootNamespace>
    <AssemblyName>OpenIrisLib</AssemblyName>
    <Platforms>x64</Platforms>
    <!-- The library itself is AnyCPU even in the x64 configuration. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <LangVersion>9.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- AssemblyVersion("1.3.*") uses a wildcard, which is incompatible with deterministic builds. -->
    <Deterministic>false</Deterministic>
    <OutputPath>..\..\bin\x64\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Name form resources after the form class, as legacy projects did (SDK default is off for .NET Framework). -->
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <!-- Don't copy ZedGraph's (an Emgu.CV.UI dependency) translated resources. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>full</DebugType>
    <DocumentationFile>$(OutputPath)OpenIrisLib.xml</DocumentationFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.ServiceModel.Web" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Windows.Forms.DataVisualization" />
  </ItemGroup>
  <!-- PrivateAssets="all": don't flow these packages to projects that reference OpenIrisLib (as with packages.config),
       otherwise every plugin copies them into Plugins\. Projects that need EmguCV reference it themselves. -->
  <ItemGroup>
    <PackageReference Include="Emgu.CV" Version="4.1.1.3497" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="7.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Calibration\CalibrationPipelineManualUI.cs" SubType="UserControl" />
    <Compile Update="Calibration\CalibrationRemoteLinearUI.cs" SubType="UserControl" />
    <Compile Update="UI\BatchAnalysis.cs" SubType="Form" />
    <Compile Update="UI\DebugImagesPanel.cs" SubType="UserControl" />
    <Compile Update="UI\EyeTrackerSettingsForm.cs" SubType="Form" />
    <Compile Update="UI\EyeTrackerTrace.cs" SubType="UserControl" />
    <Compile Update="UI\ImageEyeBox.cs" SubType="UserControl" />
    <Compile Update="UI\ProgressBarDialog.cs" SubType="Form" />
    <Compile Update="UI\SelectVideoDialog.cs" SubType="Form" />
    <Compile Update="UI\SliderTextControl.cs" SubType="UserControl" />
    <Compile Update="UI\VideoPlayerUI.cs" SubType="UserControl" />
  </ItemGroup>
</Project>
