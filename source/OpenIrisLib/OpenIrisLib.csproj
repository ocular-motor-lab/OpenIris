<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\OpenIrisPackage.props" />
  <PropertyGroup>
    <Description>The core of OpenIris, an open-source eye tracker: the base classes to write plugins (eye tracking systems, tracking pipelines and calibrations).</Description>
    <OutputType>Library</OutputType>
    <RootNamespace>OpenIris</RootNamespace>
    <AssemblyName>OpenIrisLib</AssemblyName>
    <!-- The library itself is AnyCPU even in the x64 configuration. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OutputPath>$(OpenIrisLibDir)</OutputPath>
    <LangVersion>9.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- AssemblyVersion("1.3.*") uses a wildcard, which is incompatible with deterministic builds. -->
    <Deterministic>false</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
  <!-- Don't flow these packages' DLLs to projects that reference OpenIrisLib (or its NuGet package),
       otherwise every plugin copies them into Plugins\: OpenIris has them in lib\. EmguCV flows for
       compiling only, because the plugin API uses its types (Image<Gray, byte>...). -->
  <ItemGroup>
    <PackageReference Include="Emgu.CV" PrivateAssets="runtime;build;buildTransitive;native;contentFiles;analyzers" />
    <PackageReference Include="EmbedIO" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- The web client, served by EyeTrackerWebServer from the embedded files. -->
    <EmbeddedResource Include="RemoteServices\Web\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Native Lab Streaming Layer library (liblsl), copied next to the executable so the
         P/Invoke bindings in Lsl.cs can find it. -->
    <!-- Not in the NuGet package (Pack="false"): OpenIris ships these itself. -->
    <Content Include="lsl.dll" CopyToOutputDirectory="PreserveNewest" Pack="false" />
    <!-- liblsl is MIT licensed: its notice must ship with the DLL. -->
    <Content Include="lsl.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" Pack="false" />
    <!-- EmbedIO and Swan.Lite (the web server, from NuGet) are MIT licensed: their notices ship with them. -->
    <Content Include="EmbedIO.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" Pack="false" />
    <Content Include="Swan.Lite.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>
</Project>
