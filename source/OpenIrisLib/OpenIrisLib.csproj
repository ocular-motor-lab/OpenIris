<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>OpenIris</RootNamespace>
    <AssemblyName>OpenIrisLib</AssemblyName>
    <!-- The library itself is AnyCPU even in the x64 configuration. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OutputPath>$(OpenIrisLibDir)</OutputPath>
    <LangVersion>9.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- AssemblyVersion("1.3.*") uses a wildcard, which is incompatible with deterministic builds. -->
    <Deterministic>false</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
  <!-- PrivateAssets="all": don't flow these packages to projects that reference OpenIrisLib (as with packages.config),
       otherwise every plugin copies them into Plugins\. Projects that need EmguCV reference it themselves. -->
  <ItemGroup>
    <PackageReference Include="Emgu.CV" PrivateAssets="all" />
    <PackageReference Include="EmbedIO" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- The web client, served by EyeTrackerWebServer from the embedded files. -->
    <EmbeddedResource Include="RemoteServices\Web\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Native Lab Streaming Layer library (liblsl), copied next to the executable so the
         P/Invoke bindings in Lsl.cs can find it. -->
    <Content Include="lsl.dll" CopyToOutputDirectory="PreserveNewest" />
    <!-- liblsl is MIT licensed: its notice must ship with the DLL. -->
    <Content Include="lsl.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- EmbedIO and Swan.Lite (the web server, from NuGet) are MIT licensed: their notices ship with them. -->
    <Content Include="EmbedIO.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Swan.Lite.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
