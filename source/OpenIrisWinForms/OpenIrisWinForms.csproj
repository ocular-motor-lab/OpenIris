<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows Forms parts of OpenIris: the controls, dialogs and tools that OpenIris.exe and the
       plugins with windows use. OpenIrisLib itself doesn't depend on Windows Forms. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>OpenIris</RootNamespace>
    <AssemblyName>OpenIrisWinForms</AssemblyName>
    <!-- The library itself is AnyCPU even in the x64 configuration, like OpenIrisLib. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OutputPath>$(OpenIrisLibDir)</OutputPath>
    <LangVersion>9.0</LangVersion>
    <!-- AssemblyVersion("1.3.*") uses a wildcard, which is incompatible with deterministic builds. -->
    <Deterministic>false</Deterministic>
    <!-- Name form resources after the form class, as legacy projects did (SDK default is off for .NET Framework). -->
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Windows.Forms.DataVisualization" />
  </ItemGroup>
  <!-- PrivateAssets="all": don't flow to the plugins that reference this library, as in OpenIrisLib. -->
  <ItemGroup>
    <PackageReference Include="Emgu.CV" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Calibration\CalibrationPipelineManualUI.cs" SubType="UserControl" />
    <Compile Update="Calibration\CalibrationRemoteLinearUI.cs" SubType="UserControl" />
    <Compile Update="UI\BatchAnalysis.cs" SubType="Form" />
    <Compile Update="UI\DebugImagesPanel.cs" SubType="UserControl" />
    <Compile Update="UI\EyeTrackerSettingsForm.cs" SubType="Form" />
    <Compile Update="UI\EyeTrackerTrace.cs" SubType="UserControl" />
    <Compile Update="UI\ImageEyeBox.cs" SubType="UserControl" />
    <Compile Update="UI\ProgressBarDialog.cs" SubType="Form" />
    <Compile Update="UI\SelectVideoDialog.cs" SubType="Form" />
    <Compile Update="UI\SliderTextControl.cs" SubType="UserControl" />
    <Compile Update="UI\VideoPlayerUI.cs" SubType="UserControl" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenIrisLib\OpenIrisLib.csproj" />
  </ItemGroup>
</Project>
