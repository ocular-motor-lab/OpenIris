<Project>
  <!-- The SDK is imported explicitly (not <Project Sdk=...>) so that SkipWithoutSpinnakerSdk.targets,
       imported after it, can replace the build targets when the Spinnaker SDK isn't installed. -->
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>$(OpenIrisPluginsDir)</OutputPath>
    <!-- Folder of the installed Spinnaker SDK's .NET library. Override it with -p:SpinnakerSdkDir=... -->
    <SpinnakerSdkDir Condition="'$(SpinnakerSdkDir)' == ''">$(ProgramW6432)\FLIR Systems\Spinnaker\bin64\vs2015\</SpinnakerSdkDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- SpinnakerNET must be the same version as the native Spinnaker libraries of the installed SDK,
         and FLIR's license doesn't allow redistributing it. So it isn't copied (Private=False) and
         any version builds (SpecificVersion=False): at run time OpenIris loads it from the installed
         SDK, through PATH (see EyeTrackerPluginManager.LoadFromPath). -->
    <Reference Include="SpinnakerNET_v140">
      <HintPath>$(SpinnakerSdkDir)SpinnakerNET_v140.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="SpinnakerUI.cs" SubType="Form" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenIrisLib\OpenIrisLib.csproj">
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="SkipWithoutSpinnakerSdk.targets" Condition="!Exists('$(SpinnakerSdkDir)SpinnakerNET_v140.dll')" />
</Project>
